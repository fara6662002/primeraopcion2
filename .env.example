# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Service (IONOS SMTP via Resend API)
# Configure these in Supabase Edge Function secrets after deployment
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.ionos.mx
SMTP_PORT=587
SMTP_USER=administracion@primeraopcion.mx
SMTP_PASSWORD=your-ionos-password
FROM_EMAIL=administracion@primeraopcion.mx
FROM_NAME=Primera Opción - Plataforma ECOEMS
